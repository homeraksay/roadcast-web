rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Yönetim paneli için tek yetkili hesap. Tarayıcıdaki kontrol yalnızca arayüz
    // içindir; asıl güvenlik bu kuralda uygulanır.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'info@nextron.com.tr';
    }

    // Uygulamanın ortak hikâye kataloğu, yalnızca oturum açmış kullanıcılara açıktır.
    match /points/{pointId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /admin_audio_jobs/{jobId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.createdByUid == request.auth.uid;
      allow update: if isAdmin()
        && resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByUid == request.auth.uid;
      allow delete: if isAdmin() && resource.data.createdByUid == request.auth.uid;
    }

    // Kullanıcı kendi dinleme sayacını/profil bilgisini güncelleyebilir.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/entitlements/{entitlementId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /download_packages/{packageId} {
      allow read: if request.auth != null && resource.data.status == 'PUBLISHED';
      allow write: if isAdmin();
    }
  }
}
